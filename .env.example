# MindOS Environment Configuration
# Copy to .env and fill in your values.

# WeRead API key (required for reading analysis)
# Get from: weread-skills setup
WEREAD_API_KEY=wrk-xxxxxxxx

# Vault path (default: current directory)
MINDOS_VAULT_PATH=.

# Logging level: DEBUG | INFO | WARNING | ERROR
MINDOS_LOG_LEVEL=INFO
