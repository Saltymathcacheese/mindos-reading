{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Analysis Response",
  "description": "Constrains Claude's cognitive analysis output. Every response MUST satisfy this schema before being rendered to Markdown.",
  "type": "object",
  "required": ["layer1", "layer2", "layer3", "reflection", "evidence_used"],
  "properties": {
    "layer1": {
      "type": "object",
      "required": ["content", "confidence"],
      "properties": {
        "content": {"type": "string", "minLength": 20},
        "confidence": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"]}
      }
    },
    "layer2": {
      "type": "object",
      "required": ["content", "confidence"],
      "properties": {
        "content": {"type": "string", "minLength": 20},
        "confidence": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"]}
      }
    },
    "layer3": {
      "type": "object",
      "required": ["content", "confidence"],
      "properties": {
        "content": {"type": "string", "minLength": 20},
        "confidence": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"]}
      }
    },
    "reflection": {
      "type": "string",
      "maxLength": 60,
      "description": "Single reflection question. ≤60 chars. Open-ended."
    },
    "evidence_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "fact"],
        "properties": {
          "source": {"type": "string"},
          "fact": {"type": "string"}
        }
      }
    }
  }
}
